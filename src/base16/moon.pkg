// Hexadecimal, RFC 4648 §8: https://www.rfc-editor.org/rfc/rfc4648#section-8
//
// Byte-aligned, so a leading zero byte survives the round trip — which is the
// whole reason this is not built on the big-integer core.
import {
  "moonbitstack/moonbase",
  "moonbitstack/moonbase/internal",
}

// The two-way check against the core implementation lives here rather than in a script,
// so a change on either side shows up as a failing test.
import {
  "moonbitlang/core/encoding/hex" @corehex,
  "moonbitlang/core/bench",
} for "test"
