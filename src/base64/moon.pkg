// base64, RFC 4648 §4: https://www.rfc-editor.org/rfc/rfc4648#section-4
// base64url, RFC 4648 §5: https://www.rfc-editor.org/rfc/rfc4648#section-5
//
// Six bits a character, four characters a group. The URL-safe alphabet differs
// in two characters and in that nobody pads it.
import {
  "moonbitstack/moonbase",
  "moonbitstack/moonbase/internal",
}

// The two-way check against the core implementation lives here rather than in a script,
// so a change on either side shows up as a failing test.
import {
  "moonbitlang/core/encoding/base64" @core64,
} for "test"
