// base58 in the Bitcoin alphabet: https://github.com/bitcoin/bitcoin/blob/master/src/base58.cpp
//
// The alphabet leaves out `0`, `O`, `I` and `l` so that a human copying an
// address cannot turn one into another. Leading zero bytes stay as leading `1`.

import {
  "moonbitstack/moonbase",
}

import {
  "moonbitstack/moonbase/base16",
} for "test"
