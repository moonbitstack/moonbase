name = "moonbitstack/moonbase"

version = "0.4.5"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonbase"

license = "Apache-2.0"

keywords = [
  "base2",
  "base8",
  "base10",
  "base16",
  "base32",
  "base36",
  "base45",
  "base58",
  "base62",
  "base64",
  "base85",
  "bech32",
  "bech32m",
  "multibase",
  "base64url",
  "hex",
  "base32hex",
  "crockford",
  "base32crockford",
  "zbase32",
  "z85",
  "ascii85",
  "base58check",
  "base58btc",
  "rfc4648",
  "rfc9285",
  "rfc1924",
  "bip173",
  "bip350",
  "multiformats",
  "radix",
  "binary-to-text",
  "codec",
  "decoder",
  "fingerprint",
  "pem",
  "jwt",
  "qrcode",
  "encoding",
  "moonbit",
]

description = "Every base encoding, one shape: base2 through base85, bech32 and multibase for MoonBit."

source = "src"
